includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Confirmed Larastan v3.10 / PHPStan 2.2 bug, not a real type error:
        # when an Eloquent accessor's `Attribute<TGet, TSet>` return type or
        # a cached `Collection<TKey, TValue>` static property is given
        # explicit generics, Larastan compares the method's inferred type
        # against itself and reports "not covariant" even when both sides
        # print byte-identically. Verified across several restructurings of
        # the same code (inline closures, named methods, local variables,
        # early returns) — the false positive persists regardless of
        # implementation shape, so it is not fixable from the app side.
        # The backreference below only matches when the "should return X"
        # and "but returns X" halves are identical, so a genuine mismatch
        # (different text on each side) would still be reported normally.
        -
            identifier: return.type
            message: '#should return (.+) but returns \1\.$#'
            path: app/Models/*.php
        -
            identifier: assign.propertyType
            path: app/Models/Setting.php
